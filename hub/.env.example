# Copy to hub/.env. Values here are read by docker-compose and by `python -m hub` (prefix HUB_).
HUB_DOMAIN=cloudvms.bigview.ai
HUB_PUBLIC_URL=https://cloudvms.bigview.ai
# 32+ random characters; signs sessions. Changing it signs everyone out.
HUB_SECRET=
POSTGRES_PASSWORD=
# Running without Docker on a laptop: HUB_DATABASE_URL=sqlite:///hub.db and HUB_COOKIE_SECURE=0 over plain http.
