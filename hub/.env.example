# Copy to hub/.env on the hub server. Read by docker-compose and by `python -m hub` (prefix HUB_). Never commit hub/.env.
HUB_DOMAIN=hub.axiomvision.ai
HUB_PUBLIC_URL=https://hub.axiomvision.ai
TZ=America/Chicago
# 32+ random characters (openssl rand -hex 32); signs sessions. Changing it signs everyone out.
HUB_SECRET=
# Postgres password for the bundled database (openssl rand -hex 24).
POSTGRES_PASSWORD=
# TURN relay (coturn) secret: any long random string; shared with the hub so it can mint credentials.
HUB_TURN_SECRET=
# Shared AI, one of:
#  a) a site's local Qwen serves the fleet through that site's tunnel (no GPU on the hub): its site id + model name
HUB_VLLM_SITE=
HUB_VLLM_MODEL=qwen3.5:9b
#  b) a vLLM/Ollama the hub reaches directly, e.g. the `ai` compose profile or a RunPod endpoint:
#HUB_VLLM_URL=http://vllm:8000/v1
#HUB_VLLM_KEY=
#HUB_VLLM_MODEL=Qwen/Qwen2.5-VL-32B-Instruct-AWQ
# Running without Docker on a laptop: HUB_DATABASE_URL=sqlite:///hub.db and HUB_COOKIE_SECURE=0 over plain http.
