# /etc/axiom/ai.env (root, mode 600). Read by tools/central/ai/compose.yml (--env-file and env_file) and by
# axiom_host.py, which copies VLLM_API_KEY and AXIOM_VLM_MODEL into each instance's NVR_REMOTE_VLM_KEY/_MODEL.
#
# VLLM_API_KEY: generate with   openssl rand -hex 24   (never commit it; this file is the only copy on the host)
VLLM_API_KEY=<generate: openssl rand -hex 24>
# Hugging Face token, only if the model repository is gated
HF_TOKEN=
# The model and the GPU it runs on (nvidia-smi index of the A40)
AXIOM_VLM_MODEL=Qwen/Qwen2.5-VL-32B-Instruct-AWQ
AXIOM_VLM_GPU=0
AXIOM_VLM_MAX_LEN=16384
AXIOM_VLM_GPU_UTIL=0.90
AXIOM_VLM_MAX_SEQS=16
# Pin a tested vLLM release once it works, e.g. vllm/vllm-openai:vX.Y.Z
VLLM_IMAGE=vllm/vllm-openai:latest
