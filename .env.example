# Copy to .env and fill in. .env is git-ignored; never commit credentials.

# Storage: recordings on the D: HDD; database, models and event media on the C: SSD
NVR_RECORDINGS_DIR=D:\NVR\recordings

# Camera 1 (Milesight MS-C5367-X23PE)
CAMERA_1_NAME=Front
CAMERA_1_HOST=192.168.105.12
CAMERA_1_ONVIF_PORT=80
CAMERA_1_USER=admin
CAMERA_1_PASS=

# Direct-on-LAN: a hub user whose browser can reach this server on its LAN gets media straight from it (token
# minted by the hub, read-only) instead of through the hub tunnel. The same app is also served over HTTPS on
# NVR_HTTPS_PORT with a self-signed certificate generated into data/tls/ on first start (delete that folder to
# regenerate, e.g. after the LAN address changed). Allow TCP NVR_HTTPS_PORT inbound on the LAN firewall.
#NVR_DIRECT_ENABLED=true
#NVR_HTTPS_PORT=8443
# Low-bitrate playback (?q=sd, 720p ~700 kbps H.264) for viewers off-site: concurrent transcodes allowed.
# 0 = auto: 4 when ffmpeg can use NVENC, 2 on CPU (libx264).
#NVR_PLAYBACK_TRANSCODE_MAX=0

# Browser guards (backend/nvr/lan_guard.py). The UI answers only under localhost, this machine's hostname(s)
# and local IP addresses (DNS-rebinding guard; other names get HTTP 421). Opening it under a DNS name or a
# port-forwarded public name? List those names here, comma-separated.
#NVR_ALLOWED_HOSTS=nvr.example.com,nvr-yard.lan
# Development only: trust the hub UI's dev origins (http://localhost:8000, http://localhost:5174) for
# Direct-on-LAN CORS, e.g. with a scratch hub on localhost:8000. Leave unset in production.
#NVR_DEV_ORIGINS=1
# Development only: allow a plain ws:// hub URL other than localhost (the device token then travels unencrypted).
#NVR_HUB_ALLOW_INSECURE=1
# MediaMTX viewing (RTSP / WebRTC) needs the NVR's generated reader password (kept in the database, not here).
# 0 = the old behavior: anonymous viewing from this machine and private networks.
#NVR_RTSP_AUTH=1

# Central recording instances (one server per customer Site on a datacenter host; tools/central/).
# One-time enrollment token from the hub, bound to one Site: an unenrolled server presents it instead of a claim
# code and enrolls itself. Ignored once enrolled; a refused token falls back to the claim code. Never logged.
#NVR_HUB_ENROLL_TOKEN=
# Display name on Settings -> System, e.g. "Main Street · Central". No other effect.
#NVR_INSTANCE_NAME=

# How a remote OpenAI-compatible model is told to answer without hidden "thinking" (Qwen3.x):
# reasoning_effort (default: Ollama /v1, most hosted APIs) | chat_template (vLLM) | off
#NVR_REMOTE_VLM_NO_THINK=reasoning_effort

# Local Qwen: the primary model and an optional smaller fallback (backend/nvr/vlmroute.py). Each runs in its own
# managed `ollama serve` (own port, own GPU, same model store, never unloaded). GPUs are numbered in PCI order.
# Everything goes to the primary; the fallback answers while the primary is down / starting / failing, and takes
# synopses, journeys and PPE checks when the primary has more than NVR_FALLBACK_WHEN_QUEUE_OVER requests in flight
# or waiting. Leave NVR_FALLBACK_VLM_MODEL unset for one model (as before).
#NVR_VLM_MODEL=qwen3.8:27b
#NVR_OLLAMA_GPU=1
#NVR_VLM_NUM_CTX=8192
# Parallel slots, each with its own num_ctx KV cache; 1 if the model doesn't fit in VRAM:
#NVR_OLLAMA_PARALLEL=2
#NVR_OLLAMA_URL=http://127.0.0.1:11435
#NVR_FALLBACK_VLM_MODEL=qwen3.5:9b
#NVR_FALLBACK_OLLAMA_GPU=0
#NVR_FALLBACK_OLLAMA_URL=http://127.0.0.1:11437
#NVR_FALLBACK_NUM_CTX=6144
# The fallback shares GPU 0 with YOLO, re-ID, CLIP and the display: one slot.
#NVR_FALLBACK_OLLAMA_PARALLEL=1
#NVR_FALLBACK_WHEN_QUEUE_OVER=4
# After warm-up each model must be fully in VRAM: the log says "fully in VRAM" or warns "partly on the CPU".
