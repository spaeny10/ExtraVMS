{
  "name": "Axiom Vision",
  "short_name": "Axiom",
  "description": "AI-first NVR: live cameras, events, timeline and Ask the NVR.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0d1117",
  "theme_color": "#0d1117",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Live", "url": "/#live", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Find / Ask", "url": "/#find", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Timeline", "url": "/#timeline", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
